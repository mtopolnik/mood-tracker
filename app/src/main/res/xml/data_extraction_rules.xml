<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ (Auto Backup + direct device-to-device transfer). Both carry only
     the mood database, a single file thanks to TRUNCATE journal mode. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mood.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mood.db" />
    </device-transfer>
</data-extraction-rules>
