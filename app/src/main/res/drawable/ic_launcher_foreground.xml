<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Mood cloud, centred in the adaptive-icon safe zone. A hard "/"
         diagonal splits it: grey (low mood) on the upper-left side,
         pink (good mood) on the lower-right side, no blend between them.
         Implemented as a linear fill from top-left to bottom-right with
         both colour stops doubled at offset 0.5, so there is no actual
         gradient: just a crisp "/" colour-change line. -->
    <group
        android:translateX="20.4"
        android:translateY="20.4"
        android:scaleX="2.8"
        android:scaleY="2.8">
        <path android:pathData="M19.35,10.04 C18.67,6.59 15.64,4 12,4 C9.11,4 6.6,5.64 5.35,8.04 C2.34,8.36 0,10.91 0,14 C0,17.31 2.69,20 6,20 H19 C21.76,20 24,17.76 24,15 C24,12.36 21.95,10.22 19.35,10.04 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="4" android:startY="4"
                    android:endX="20" android:endY="20">
                    <item android:offset="0" android:color="#FF8C929B" />
                    <item android:offset="0.5" android:color="#FF8C929B" />
                    <item android:offset="0.5" android:color="#FFF48FB1" />
                    <item android:offset="1" android:color="#FFF48FB1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
